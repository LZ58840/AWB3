{
  "name": "awb3",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server/index.cjs --sourcemap --sources-content=false --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:red-first": "bash tools/red-first.sh",
    "test:calibration": "vitest run --config test/calibration/vitest.config.ts",
    "test:release": "vitest run --config test/replay/vitest.release.config.ts",
    "lint": "vitest run test/lint"
  },
  "devDependencies": {
    "@devvit/protos": "0.15.2",
    "@devvit/redis": "0.15.2",
    "@devvit/settings": "0.15.2",
    "@devvit/shared-types": "0.15.2",
    "@devvit/test": "0.15.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "devvit": "0.15.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "ioredis-mock": "8.13.1",
    "js-yaml": "3.15.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@devvit/web": "0.15.2",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "hono": "4.13.18",
    "jpeg-js": "0.4.4"
  }
}
